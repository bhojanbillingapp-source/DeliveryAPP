# Copy this to android/local.properties (gitignored) — Android Studio
# usually generates that file with sdk.dir already; just add this line to it.
#
# Google Maps API key used by react-native-maps on Android (the manual
# "pick on map" delivery-address picker). Needs Maps SDK for Android enabled
# on the key — see the setup guide in the app's docs/chat for how to create one.
MAPS_API_KEY=
